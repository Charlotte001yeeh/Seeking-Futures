# ============================================================================
#  环境变量模板 —— 复制为 .env 后填入自己的值（.env 已被 .gitignore 忽略）
# ============================================================================
#  用法：
#      cp .env.example .env        # Windows: copy .env.example .env
#  然后编辑 .env。真实环境变量优先于 .env（CI/容器里直接注入即可）。
#
#  ⚠️ 绝对不要把填好的 .env 提交到 git。
# ============================================================================


# ── 大商所（DCE）官方 API 凭据【必填】────────────────────────────────────────
# 为什么必填：六大交易所的完整性校验要求当天六所数据齐全；缺 DCE 会导致
# 榜单被判定为"当日不完整"而退回上一完整交易日。
# 获取方式：https://www.dce.com.cn/ → 数据 → API 服务（免费注册）
DCE_API_KEY=
DCE_SECRET=
# 可选：自建代理/镜像时改这里（默认 www.dce.com.cn）
# DCE_HOST=www.dce.com.cn


# ── 实时服务（realtime-server）──────────────────────────────────────────────
# 全部可选，下面是默认值；改端口即可换前端地址 http://<本机IP>:<port>/
# RT_HOST=0.0.0.0
# RT_PORT=8899
# 主轮询节拍（毫秒）。实测新浪源约 500ms 一拍，1.5s 与之 3:1
# RT_INTERVAL_MS=1500
# RT_BACKOFF_MS=5000
# RT_IDLE_ROUNDS=10
# RT_TIMEOUT_MS=5000
# 流量闸门（硬约束，超过自动延长节拍）
# RT_MAX_RPS=1
# RT_MAX_RPM=60
# RT_MAX_RPD=40000
# 落库节流与文件名
# RT_STORE_MS=10000
# RT_NAME=盘中实时
# 数据/服务目录（默认：数据 <repo>/rank20、服务 <repo>/realtime-server/var）
# RT_BASE=
# RT_OUT=
# RT_VAR=


# ── 模型 API（可选）────────────────────────────────────────────────────────
# 注意：模型接口地址 / 模型名 / API Key **不放在这里**。
# 它们由前端「运行状态 → 模型 API」填写，保存在服务端本地文件
# <repo>/realtime-server/var/model.json（权限 0600），页面只显示掩码，绝不明文回传。
# 想用环境变量注入，可在启动前 export MODEL_BASE_URL / MODEL_API_KEY（当前版本未读取，
# 如需请提 issue —— 见 README「已知限制」）。


# ── 构建工具链（可选）──────────────────────────────────────────────────────
# 只有在仓库自带的 node_modules 找不到 typescript/esbuild 时才需要指定。
# TSC_JS=<path-to>/typescript/lib/tsc.js
# ESBUILD=<path-to>/esbuild(.exe)
# DSH_CHECKOUT=<path-to>/deepseek-harness   # 兼容旧变量，仅作最后兜底
